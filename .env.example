# Copy to .env. Uncomment and fill in the two credential values, or leave them
# commented to use process environment variables / the fallback file below.
# Do not commit your populated .env file.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=

# Optional credentials-file path. Default: ~/.alpaca-mcp.env
# Used when either Alpaca credential is absent. Explicitly empty variables are
# not overwritten by dotenv, so omit unused credential entries rather than
# setting them to empty strings.
# ALPACA_ENV_FILE=

# Simulation settings (shown values are the defaults).
BOT_SYMBOL=QQQ
BOT_QUANTITY=10
BOT_MAX_POSITION=20
BOT_REPLAY_DAYS=60

# No live order path is implemented. ALLOW_LIVE_TRADING=true is rejected.
